<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The bindings: the engine's C ABI generated as P/Invoke (Interop/), and the
    C# layer over it. netstandard2.1 is what Unity loads; C# 9 is the newest
    it compiles. Every signature is blittable, so nothing here needs a
    marshalling stub — IL2CPP and NativeAOT take it as it is.

    This package carries no engine. A consumer adds RippleFx.Engine.Native or
    RippleFx.Engine.Native.NoPython beside it.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RippleFx.Engine</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Undocumented members are the generated interop's, and say so by name. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>

    <PackageId>RippleFx.Engine</PackageId>
    <Version>$(RippleVersion)</Version>
    <Description>C# bindings of the Ripple Effect engine: open a compiled campaign, play it through a session or a player, and drive its soundscapes through a speaker of your own. Add RippleFx.Engine.Native (or .NoPython) for the engine itself.</Description>
    <PackageTags>ripple-effect;interactive-fiction;narrative;dialogue;game;unity</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RippleFx.Engine.Tests" />
    <None Include="$(RippleRoot)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
